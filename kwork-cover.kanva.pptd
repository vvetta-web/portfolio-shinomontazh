version: v2
title: Обложка Kwork — сайт Шинный двор
size: [1100, 740]
customFonts:
  - family: Onest
    src: "https://fonts.googleapis.com/css2?family=Onest"
  - family: Tenor Sans
    src: "https://fonts.googleapis.com/css2?family=Tenor+Sans"
theme:
  colors:
    bg: "#0f0d0a"
    ink: "#f4eee4"
    soft: "#a69c8e"
    accent: "#ff7a2f"
    card: "#221d17"
  textStyles:
    kicker:
      fontSize: 15
      fontFamily: Onest
      color: "$accent"
      bold: true
      letterSpacing: 3
    body:
      fontSize: 17
      fontFamily: Onest
      color: "$soft"
      lineHeight: 1.55
pages:
  - pages/1_cover.page
